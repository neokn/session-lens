]

def run():
    p = subprocess.run(["claude", "plugin", "test", "."], capture_output=True, text=True)
    return p.returncode == 0

if subprocess.run(["scripts/boundaries"]).returncode != 0:
    sys.exit("boundaries fail; fix the imports before mutating")
if not run():
    sys.exit("baseline fails; fix the tests before mutating")
survived = 0
for path, name, old, new in MUTANTS:
    f = Path(path); src = f.read_text()
    if src.count(old) != 1:
        print(f"STALE    {name} (pattern not found once in {path})"); survived += 1; continue
    try:
        f.write_text(src.replace(old, new))
        killed = not run()
    finally:
        f.write_text(src)
    print(("killed   " if killed else "SURVIVED ") + name)
    survived += 0 if killed else 1
sys.exit(1 if survived else 0)
PY
